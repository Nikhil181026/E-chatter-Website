
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BGMI News | E-chatter</title>
  <meta name="description" content="भारत के BGMI esports की ताज़ा खबरें, टूर्नामेंट, टीम और मैच अपडेट।">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #100b14;
      color: #fff;
      font-family: Arial, sans-serif;
    }
    header {
      padding: 24px 7%;
      border-bottom: 1px solid #382333;
    }
    header a { color: #d8ff52; text-decoration: none; }
    .hero {
      padding: 75px 7% 45px;
      background: linear-gradient(120deg, #321326, #100b14 70%);
    }
    .hero small { color: #d8ff52; letter-spacing: 3px; }
    h1 { font-size: clamp(38px, 7vw, 76px); margin: 15px 0; }
    .hero p { color: #c8bdca; font-size: 17px; }
    main { padding: 45px 7%; }
    .articles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
    }
    .article {
      background: #1c1420;
      border: 1px solid #39263a;
      border-radius: 16px;
      overflow: hidden;
      transition: transform .25s, border-color .25s;
    }
    .article:hover {
      transform: translateY(-6px);
      border-color: #d8ff52;
    }
    .article img {
      width: 100%;
      height: 190px;
      object-fit: cover;
    }
    .content { padding: 22px; }
    .category { color: #d8ff52; font-size: 13px; }
    .date { color: #a99eac; font-size: 13px; }
    h2 { font-size: 23px; line-height: 1.3; }
    .description { color: #c8bdca; line-height: 1.6; }
    .read {
      display: inline-block;
      margin-top: 12px;
      color: #d8ff52;
      text-decoration: none;
      font-weight: bold;
    }
    .empty {
      padding: 35px;
      border: 1px dashed #65465f;
      border-radius: 14px;
      color: #c8bdca;
    }
    footer {
      padding: 30px 7%;
      color: #a99eac;
      border-top: 1px solid #382333;
    }
  </style>
</head>
<body>
  <header>
    <a href="/">← E-chatter Home</a>
  </header>

  <section class="hero">
    <small>E-CHATTER ESPORTS DESK</small>
    <h1>THE BATTLEGROUND.<br>THE STORIES.</h1>
    <p>भारत के BGMI esports की खबरें, टूर्नामेंट और मैच अपडेट।</p>
  </section>

  <main>
    <h2>Latest BGMI News</h2>

    {% set articles = collections.bgmi_news %}

    {% if articles.length %}
      <div class="articles">
        {% for article in articles %}
          <article class="article">
            {% if article.data.featured_image %}
              <img src="{{ article.data.featured_image }}" alt="{{ article.data.title }}">
            {% endif %}
            <div class="content">
              <span class="category">{{ article.data.category }}</span>
              <p class="date">{{ article.date.toLocaleDateString("hi-IN") }}</p>
              <h2>{{ article.data.title }}</h2>
              <p class="description">{{ article.data.description }}</p>
              <a class="read" href="{{ article.url }}">पूरी खबर पढ़ें →</a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty">
        <h2>पहली रिपोर्ट जल्द आ रही है!</h2>
        <p>BGMI की ताज़ा खबरों के लिए फिर आएं।</p>
      </div>
    {% endif %}
  </main>

  <footer>© E-chatter — Dream. Design. Deliver.</footer>
</body>
</html>
