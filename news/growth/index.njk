
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080711">
<title>News to Grow | E-chatter</title>
<meta name="description" content="Explore the future of AI, technology, startups and digital business with News to Grow by E-chatter.">

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  --bg: #080711;
  --panel: rgba(255,255,255,.055);
  --white: #f8f6ff;
  --muted: #aaa5bd;
  --cyan: #55edff;
  --violet: #a16aff;
  --pink: #ff54c8;
  --lime: #d8ff52;
}

* { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior:smooth; }

body {
  background:var(--bg);
  color:var(--white);
  font-family:'DM Sans',sans-serif;
  overflow-x:hidden;
}

a { color:inherit; text-decoration:none; }

button { font:inherit; }

.background-glow {
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-2;
  background:
    radial-gradient(ellipse at 15% 20%,rgba(107,53,173,.20),transparent 35%),
    radial-gradient(ellipse at 85% 40%,rgba(0,181,208,.12),transparent 35%),
    radial-gradient(ellipse at 50% 95%,rgba(180,47,142,.12),transparent 40%);
}

#particles {
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:-1;
}

.navbar {
  position:sticky;
  top:0;
  z-index:20;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:20px 7%;
  background:rgba(8,7,17,.78);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,255,255,.08);
}

.logo {
  font-family:'Space Grotesk',sans-serif;
  font-size:23px;
  font-weight:700;
  letter-spacing:-1px;
}

.logo span { color:var(--cyan); }

.nav-links {
  display:flex;
  gap:28px;
  align-items:center;
  font-size:13px;
  color:var(--muted);
}

.nav-links a:hover { color:var(--cyan); }

.nav-cta {
  border:1px solid rgba(85,237,255,.4);
  padding:10px 17px;
  border-radius:30px;
  color:var(--cyan);
}

.hero {
  min-height:720px;
  display:grid;
  grid-template-columns:1.05fr .95fr;
  align-items:center;
  padding:75px 8% 90px;
  position:relative;
  overflow:hidden;
}

.hero-copy { position:relative; z-index:2; }

.eyebrow {
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:9px 14px;
  border:1px solid rgba(85,237,255,.25);
  border-radius:30px;
  background:rgba(85,237,255,.055);
  color:var(--cyan);
  font-size:11px;
  letter-spacing:2px;
  text-transform:uppercase;
}

.live-dot {
  width:7px;
  height:7px;
  background:var(--lime);
  border-radius:50%;
  box-shadow:0 0 12px var(--lime);
  animation:pulse 1.6s infinite;
}

h1 {
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(55px,7.2vw,100px);
  line-height:.98;
  letter-spacing:-5px;
  margin:30px 0 25px;
}

.gradient-text {
  background:linear-gradient(100deg,var(--cyan),var(--violet),var(--pink));
  background-size:200% auto;
  color:transparent;
  background-clip:text;
  -webkit-background-clip:text;
  animation:gradient 6s linear infinite;
}

.hero-copy p {
  color:var(--muted);
  font-size:17px;
  line-height:1.8;
  max-width:520px;
}

.hero-actions {
  display:flex;
  gap:14px;
  margin-top:35px;
  flex-wrap:wrap;
}

.primary-btn,.secondary-btn {
  padding:15px 23px;
  border-radius:9px;
  font-size:13px;
  font-weight:700;
  transition:.3s;
}

.primary-btn {
  background:linear-gradient(110deg,#55edff,#a16aff);
  color:#090814;
  box-shadow:0 0 28px rgba(85,237,255,.19);
}

.primary-btn:hover {
  transform:translateY(-4px);
  box-shadow:0 0 40px rgba(85,237,255,.4);
}

.secondary-btn {
  border:1px solid rgba(255,255,255,.17);
  color:white;
}

.secondary-btn:hover {
  border-color:var(--cyan);
  color:var(--cyan);
}

/* 3D HOLOGRAPHIC ORB */

.orb-stage {
  height:510px;
  display:grid;
  place-items:center;
  perspective:1100px;
  position:relative;
}

.orb {
  position:relative;
  width:min(360px,75vw);
  aspect-ratio:1;
  border-radius:50%;
  transform-style:preserve-3d;
  animation:float 7s ease-in-out infinite, rotateOrb 24s linear infinite;
  background:
    radial-gradient(circle at 32% 28%,rgba(255,255,255,.55),transparent 9%),
    radial-gradient(circle at 38% 36%,#4b3485 0%,#17102e 36%,#090817 69%);
  box-shadow:
    inset -35px -35px 70px #02020a,
    inset 15px 12px 45px rgba(132,89,255,.5),
    0 0 50px rgba(161,106,255,.25),
    0 0 120px rgba(85,237,255,.12);
}

.orb::before,.orb::after {
  content:"";
  position:absolute;
  inset:-20px;
  border:1px solid rgba(85,237,255,.45);
  border-radius:50%;
  transform:rotateX(70deg) rotateY(-18deg);
  box-shadow:0 0 25px rgba(85,237,255,.15);
}

.orb::after {
  inset:-43px;
  border-color:rgba(255,84,200,.4);
  transform:rotateX(72deg) rotateY(40deg);
}

.orb-core {
  position:absolute;
  inset:22%;
  border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#8dfaff,#4c69ba 32%,#221344 70%);
  opacity:.6;
  filter:blur(2px);
  box-shadow:0 0 55px rgba(85,237,255,.3);
}

.orb-ring {
  position:absolute;
  inset:-62px;
  border:1px dashed rgba(216,255,82,.35);
  border-radius:50%;
  transform:rotateX(75deg) rotateY(-25deg);
  animation:ringSpin 18s linear infinite;
}

.orb-label {
  position:absolute;
  bottom:5%;
  right:-2%;
  padding:13px 17px;
  border:1px solid rgba(85,237,255,.25);
  background:rgba(9,8,22,.7);
  backdrop-filter:blur(12px);
  border-radius:12px;
  font-size:11px;
  color:var(--cyan);
  letter-spacing:2px;
  box-shadow:0 10px 35px #000;
}

.orb-label span { display:block; color:white; font-size:17px; margin-top:5px; }

.orb-chip {
  position:absolute;
  top:13%;
  left:0;
  border:1px solid rgba(255,84,200,.35);
  background:rgba(255,84,200,.08);
  color:#ff8be0;
  border-radius:10px;
  padding:12px 15px;
  font-size:12px;
  animation:float 5s ease-in-out infinite reverse;
}

/* MOVING DATA STRIP */

.ticker {
  overflow:hidden;
  border-top:1px solid rgba(255,255,255,.08);
  border-bottom:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.025);
  padding:19px 0;
}

.ticker-track {
  display:flex;
  width:max-content;
  animation:marquee 32s linear infinite;
}

.ticker-track span {
  padding:0 35px;
  color:#c6bed8;
  font-family:'Space Grotesk',sans-serif;
  font-size:13px;
  letter-spacing:2px;
  white-space:nowrap;
}

.ticker-track b { color:var(--cyan); margin-right:10px; }

/* SECTIONS */

.section {
  padding:100px 8%;
}

.section-heading {
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:25px;
  margin-bottom:40px;
}

.section-heading small {
  color:var(--cyan);
  letter-spacing:3px;
  font-size:11px;
}

.section-heading h2 {
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(34px,5vw,55px);
  margin-top:12px;
  letter-spacing:-2px;
}

.section-heading p {
  color:var(--muted);
  max-width:350px;
  line-height:1.7;
  font-size:14px;
}

/* CATEGORY FILTERS */

.filters {
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:35px;
}

.filter-btn {
  padding:11px 19px;
  border-radius:30px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.1);
  color:#bbb4ca;
  cursor:pointer;
  font-size:12px;
  transition:.3s;
}

.filter-btn:hover,.filter-btn.active {
  background:rgba(85,237,255,.1);
  border-color:var(--cyan);
  color:var(--cyan);
  box-shadow:0 0 20px rgba(85,237,255,.1);
}

/* NEWS CARDS */

.news-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:22px;
  perspective:1200px;
}

.news-card {
  min-height:290px;
  position:relative;
  overflow:hidden;
  padding:28px;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.1);
  background:
    linear-gradient(145deg,rgba(255,255,255,.085),rgba(255,255,255,.018));
  backdrop-filter:blur(15px);
  transform-style:preserve-3d;
  transition:border-color .35s,box-shadow .35s;
}

.news-card::before {
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  border-radius:50%;
  right:-75px;
  top:-80px;
  background:var(--card-glow,rgba(85,237,255,.22));
  filter:blur(50px);
  pointer-events:none;
}

.news-card:hover {
  border-color:rgba(85,237,255,.5);
  box-shadow:0 25px 55px rgba(0,0,0,.3),0 0 25px rgba(85,237,255,.07);
}

.card-number {
  font-family:'Space Grotesk',sans-serif;
  font-size:42px;
  font-weight:700;
  color:rgba(255,255,255,.12);
  transform:translateZ(30px);
}

.card-icon {
  font-size:29px;
  margin:20px 0;
  transform:translateZ(45px);
}

.news-card h3 {
  font-family:'Space Grotesk',sans-serif;
  font-size:22px;
  margin-bottom:12px;
  transform:translateZ(35px);
}

.news-card p {
  color:var(--muted);
  font-size:13px;
  line-height:1.7;
  transform:translateZ(25px);
}

.card-link {
  display:inline-block;
  margin-top:22px;
  font-size:12px;
  color:var(--cyan);
  transform:translateZ(40px);
}

.news-card[data-category="AI"] { --card-glow:rgba(85,237,255,.24); }
.news-card[data-category="Technology"] { --card-glow:rgba(161,106,255,.28); }
.news-card[data-category="Startups"] { --card-glow:rgba(255,84,200,.22); }
.news-card[data-category="Business"] { --card-glow:rgba(216,255,82,.18); }

.news-card.hidden { display:none; }

/* FEATURE STRIP */

.feature {
  margin:20px 8% 100px;
  padding:55px;
  border-radius:25px;
  border:1px solid rgba(161,106,255,.25);
  background:
    radial-gradient(circle at 90% 20%,rgba(161,106,255,.19),transparent 40%),
