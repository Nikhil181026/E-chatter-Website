  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
  overflow:hidden;
  position:relative;
}

.feature h2 {
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(28px,4vw,45px);
  margin:15px 0;
}

.feature p {
  color:var(--muted);
  line-height:1.7;
  max-width:550px;
}

.feature-sphere {
  width:160px;
  height:160px;
  flex-shrink:0;
  border-radius:50%;
  background:radial-gradient(circle at 30% 25%,#b4ffff,#8c52df 35%,#26133d 70%);
  box-shadow:inset -20px -20px 35px #090711,0 0 60px rgba(161,106,255,.3);
  animation:float 6s ease-in-out infinite;
}

/* FOOTER */

footer {
  padding:35px 8%;
  display:flex;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
  border-top:1px solid rgba(255,255,255,.08);
  color:var(--muted);
  font-size:12px;
}

footer a { color:var(--cyan); }

/* ANIMATIONS */

@keyframes float {
  0%,100% { transform:translateY(0); }
  50% { transform:translateY(-18px); }
}

@keyframes rotateOrb {
  from { filter:hue-rotate(0deg); }
  to { filter:hue-rotate(35deg); }
}

@keyframes ringSpin {
  from { transform:rotateX(75deg) rotateY(-25deg) rotateZ(0deg); }
  to { transform:rotateX(75deg) rotateY(-25deg) rotateZ(360deg); }
}

@keyframes pulse {
  50% { opacity:.35; box-shadow:0 0 2px var(--lime); }
}

@keyframes gradient {
  to { background-position:200% center; }
}

@keyframes marquee {
  to { transform:translateX(-50%); }
}

.reveal {
  opacity:0;
  transform:translateY(30px);
  transition:opacity .8s ease,transform .8s ease;
}

.reveal.visible {
  opacity:1;
  transform:translateY(0);
}

/* MOBILE */

@media(max-width:900px) {
  .hero {
    grid-template-columns:1fr;
    text-align:center;
    padding-top:80px;
  }
  .hero-copy p { margin:auto; }
  .hero-actions { justify-content:center; }
  .orb-stage { height:440px; margin-top:25px; }
  .section-heading { display:block; }
  .section-heading p { margin-top:15px; }
  .news-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}

@media(max-width:600px) {
  .navbar { padding:17px 5%; }
  .nav-links { gap:13px; font-size:11px; }
  .nav-links a:nth-child(2),.nav-links a:nth-child(3) { display:none; }
  .nav-cta { padding:8px 11px; }
  .hero { padding:65px 6% 55px; }
  h1 { letter-spacing:-3px; }
  .orb-stage { height:350px; }
  .orb { width:240px; }
  .orb-label { right:-10px; }
  .section { padding:70px 6%; }
  .news-grid { grid-template-columns:1fr; }
  .feature { margin:10px 6% 70px; padding:30px; }
  .feature-sphere { width:90px; height:90px; }
}

@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    animation-duration:.01ms !important;
    transition-duration:.01ms !important;
    scroll-behavior:auto !important;
  }
}
</style>
</head>

